--11 	 --Find departments where the total salary is greater than the company's average total salary per department.

--Display:
--Department Name
--Total Salary
--Number of Employees
--sort by Total Salary in descending order.

SELECT
    d.dept_name,
    SUM(e.salary) AS Total_salary,
    COUNT(e.emp_id) AS Num_emp
FROM Employees e
JOIN Departments d
    ON e.dept_id = d.dept_id
GROUP BY d.dept_name, d.dept_id
HAVING SUM(e.salary) > (
    SELECT AVG(Dept_Total)
    FROM (
        SELECT SUM(e2.salary) AS Dept_Total
        FROM Employees e2
        GROUP BY e2.dept_id
    ) AS Dept_Summary
)
ORDER BY Total_salary DESC;

--12 Find employees who earn the highest salary in their respective departments.

--Display:
--Employee Name
--Department Name
--Salary
--Department Name's total employee count
--If multiple employees share the highest salary in a department, display all of them.

--Sort by salary in descending order.

    SELECT e.emp_name,d.dept_name,e.salary,
	   (SELECT COUNT(e2.emp_id) FROM Employees e2
	       WHERE e2.dept_id = e.dept_id) AS Dept_empcount
		  FROM Employees e
		  JOIN Departments d
