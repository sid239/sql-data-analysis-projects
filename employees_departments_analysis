-- Basic Analysis
SELECT * FROM Employees;

SELECT * FROM Departments;

SELECT emp_name, salary
FROM Employees
ORDER BY salary DESC;



-- 1. Department-wise employee count
SELECT
    d.dept_name,
    COUNT(e.emp_id) AS employee_count
FROM Employees e
JOIN Departments d
    ON e.dept_id = d.dept_id
GROUP BY d.dept_name;

-- 2. Highest paid employee
SELECT
    emp_name,
    salary
FROM Employees
ORDER BY salary DESC
LIMIT 1;

-- 3. Department-wise average salary
SELECT
    d.dept_name,
    AVG(e.salary) AS avg_salary
FROM Employees e
JOIN Departments d
    ON e.dept_id = d.dept_id
GROUP BY d.dept_name;

-- 4. Employees earning above 80000
SELECT
    emp_name,
    salary
FROM Employees
WHERE salary > 80000;

-- 5. Total salary by department
SELECT
    d.dept_name,
    SUM(e.salary) AS total_salary
FROM Employees e
JOIN Departments d
    ON e.dept_id = d.dept_id
GROUP BY d.dept_name;


