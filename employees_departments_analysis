--14Find departments where the highest-paid employee earns more than ₹90,000 and the department has at least 3 employees.

--Display:
--Department Name
--Highest Salary
--Average Salary
--Total Employees
--Sort by Highest Salary in descending order.

    SELECT d.dept_name,MAX(e.salary) AS Higest_salary,
	    AVG(e.salary) AS AVG_salary,
		COUNT(e.emp_id) AS Count_emp
		 FROM Employees e
		 JOIN Departments d
		 ON e.dept_id = d.dept_id
		 WHERE e.salary = (
                SELECT MAX(e2.salary)FROM Employees e2
				WHERE e2.dept_id = e.dept_id
		 )
		 GROUP BY d.dept_id ,d.dept_name
		 HAVING COUNT(*)>=3
		 AND MAX(e.salary) > 90000
		   ORDER BY Higest_salary DESC;

